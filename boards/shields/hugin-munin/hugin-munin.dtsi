#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include "hugin-munin-layouts.dtsi"

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

// Note: RC(3,5) and RC(3,6) are connected to the encoders (position not quite like in the matrix)
/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)      RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)      RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
                    RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)      RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                    RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)      RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10)
        >;
    };
};

&physical_layout0 {
    kscan = <&kscan0>; // label of the kscan node this layout uses
    transform = <&default_transform>; // label of the matrix transform this layout uses
};

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };
    
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <24>;
    };
};

&pinctrl {
    pwm_led_default: pwm_led_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 22)>,
                    <NRF_PSEL(PWM_OUT1, 0, 20)>,
                    <NRF_PSEL(PWM_OUT2, 0, 17)>;
        };
    };
    pwm_led_sleep: pwm_led_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 22)>,
                    <NRF_PSEL(PWM_OUT1, 0, 20)>,
                    <NRF_PSEL(PWM_OUT2, 0, 17)>;
            low-power-enable;
        };
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm_led_default>;
    pinctrl-1 = <&pwm_led_sleep>;
    pinctrl-names = "default", "sleep";
};

// Note: in the scematic, the leds are labeled 0 to 2 from outside to inside
// but I labeled them from inside to outside when writing the led module
// These pin labels follow (have to follow) the modules naming convention
/ {
    status_leds {
        compatible = "pwm-leds";
        status_led_0: led_0 {pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>; };
        status_led_1: led_1 {pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>; };
        status_led_2: led_2 {pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>; };
    };
};